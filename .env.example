# =============================================================================
#  Clinix — environment configuration
#  Copy to `.env` and fill in. Every value below has a working default, so the
#  app runs with an EMPTY .env — integrations simply degrade instead of failing.
# =============================================================================

# ---- Application ------------------------------------------------------------
APP_NAME="Clinix — Healthcare Appointment & Follow-up Manager"
CLINIC_NAME="Clinix Care Clinic"
ENVIRONMENT=development                 # development | production  (production enforces a real JWT_SECRET)
DEBUG=true
PUBLIC_BASE_URL=http://localhost:8000   # used in emails and the Google OAuth redirect
CORS_ORIGINS=*                          # comma-separated list in production

# ---- Database ---------------------------------------------------------------
# Leave unset for SQLite (a file next to the code). Set to Postgres in production.
# Render/Railway hand out postgres:// URLs — those are rewritten automatically.
# DATABASE_URL=postgresql://user:password@host:5432/clinix

# ---- Security ---------------------------------------------------------------
# REQUIRED in production. Generate one:  python -c "import secrets;print(secrets.token_hex(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=720

# ---- Clinic rules -----------------------------------------------------------
CLINIC_TIMEZONE=Asia/Kolkata   # any IANA zone; all slots are generated in this zone
SLOT_HOLD_MINUTES=5            # how long a slot is reserved while the symptom form is filled
BOOKING_HORIZON_DAYS=45        # how far ahead patients may book
MIN_LEAD_MINUTES=30            # no bookings closer than this to the start time
REMINDER_LEAD_HOURS=24         # when the "your appointment is tomorrow" email goes out

# ---- LLM (Google Gemini) ----------------------------------------------------
# Free key: https://aistudio.google.com/apikey
# WITHOUT this the app still works — summaries come from the rule-based fallback
# and `source` is recorded as "fallback" on every stored summary.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=25
LLM_MAX_ATTEMPTS=3                 # retries on timeout / 429 / 5xx, with backoff + jitter
LLM_BREAKER_THRESHOLD=4            # consecutive failures before the circuit breaker opens
LLM_BREAKER_COOLDOWN_SECONDS=120

# ---- Email ------------------------------------------------------------------
# `auto` picks SendGrid if a key is present, else SMTP, else the on-disk outbox.
EMAIL_PROVIDER=auto                # auto | sendgrid | smtp | outbox
EMAIL_FROM=no-reply@clinix.health
EMAIL_FROM_NAME=Clinix Care Clinic
OUTBOX_DIR=./var/outbox            # where .eml files land when no provider is configured

# Option A — SendGrid (free tier: 100 emails/day)
SENDGRID_API_KEY=

# Option B — SMTP (Gmail needs an App Password, not your account password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# ---- Google Calendar (OAuth 2.0) --------------------------------------------
# See docs/GOOGLE_CALENDAR_SETUP.md. Without these, calendar tasks are skipped
# and marked "cancelled" in the admin Operations queue — bookings are unaffected.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/calendar/callback

# ---- Background worker ------------------------------------------------------
WORKER_ENABLED=true                # set false on web dynos if running a separate worker process
WORKER_INTERVAL_SECONDS=20
NOTIFICATION_MAX_ATTEMPTS=5        # after this a notification is dead-lettered for an admin

# ---- Demo data --------------------------------------------------------------
SEED_DEMO_DATA=true                # seeds 6 doctors, 3 patients and 2 appointments on first boot
ADMIN_EMAIL=admin@clinix.health
ADMIN_PASSWORD=Admin@12345         # CHANGE THIS before deploying anywhere public
